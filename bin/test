#!/usr/bin/env bash
set -euo pipefail

candidate_bash() {
  local candidate=""

  for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash "$(command -v bash)"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    if "$candidate" -lc '(( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3) ))' >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

main() {
  local modern_bash=""

  command -v bats >/dev/null 2>&1 || {
    echo "kxxx: bats is required to run the test suite" >&2
    exit 1
  }

  modern_bash="$(candidate_bash)" || {
    echo "kxxx: Bash 4.3 or later is required to run the test suite" >&2
    exit 1
  }

  if (($# == 0)); then
    set -- test
  fi

  PATH="$(dirname "$modern_bash"):$PATH" exec bats "$@"
}

main "$@"
