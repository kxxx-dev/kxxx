#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  LINK_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$LINK_DIR/$SOURCE_PATH"
done

SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/common.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/secret_ref.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/keychain.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/backend_memory.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/backend_encrypted_file.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/backend.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/identity.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/broker.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/repo.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/env.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/migrate.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/audit.sh"
# shellcheck source=/dev/null
source "${ROOT_DIR}/lib/kxxx/cli_commands.sh"
kxxx_require_bash_version

kxxx_usage() {
  cat <<'USAGE'
Usage:
  kxxx set <account> [--value <value>|--stdin] [--json] [--service <name>] [--backend <name>]
  kxxx ref <account> [--service <name>] [--backend <name>] [--json]
  kxxx get <account> [--service <name>] [--backend <name>] [--fallback-service <name>]
  kxxx list [--service <name>] [--backend <name>] [--json]
  kxxx env [--repo <auto|name>] [--shell <zsh|bash|dotenv|json>] [--service <name>] [--backend <name>] [--strict]
  kxxx run [--repo <auto|name>] [--service <name>] [--backend <name>] -- <command...>
  kxxx backend info [--backend <name>] [--json]
  kxxx broker github.create_issue [--service <name>] --ref <secret-ref> --repo <owner/repo> --title <title> [--body <body>]
  kxxx broker github.create_issue_comment [--service <name>] --ref <secret-ref> --repo <owner/repo> --issue <number> --body <body>
  kxxx broker github.close_issue [--service <name>] --ref <secret-ref> --repo <owner/repo> --issue <number>
  kxxx broker audit [--file <path>]
  kxxx migrate import [--dry-run|--apply] [--service <name>] [--backend <name>] [--keys-root <path>]
  kxxx migrate service [--from <name>] [--to <name>] [--from-backend <name>] [--to-backend <name>] [--dry-run|--apply]
  kxxx audit [--summary|--list] [--strict] [paths...]

Modes:
  Safe path: `kxxx broker ...` is the preferred path for new integrations and keeps raw secret values behind the broker boundary.
  Compatibility path: `kxxx get`, `kxxx env`, and `kxxx run` can materialize raw secrets for existing workflows.
  Threat model and invariants: https://github.com/kxxx-dev/kxxx/blob/main/docs/adr/0001-agent-safe-secret-runtime.md

Defaults:
  service: kxxx.secrets
  backend: auto (platform-based: `darwin-keychain` on supported macOS environments, otherwise `encrypted-file`)
  repo: auto
USAGE
}

cmd_env() {
  kxxx_env_main "$@"
}

cmd_run() {
  kxxx_run_main "$@"
}

cmd_migrate() {
  [[ $# -gt 0 ]] || kxxx_die "migrate subcommand is required (import|service)"
  local sub="$1"
  shift
  case "$sub" in
    import)
      kxxx_migrate_import_main "$@"
      ;;
    service)
      kxxx_migrate_service_main "$@"
      ;;
    *)
      kxxx_die "unknown migrate subcommand: $sub"
      ;;
  esac
}

cmd_broker() {
  kxxx_broker_main "$@"
}

cmd_audit() {
  kxxx_audit_main "$@"
}

main() {
  [[ $# -gt 0 ]] || {
    kxxx_usage
    return 0
  }

  local cmd="$1"
  shift

  case "$cmd" in
    set)
      cmd_set "$@"
      ;;
    ref)
      cmd_ref "$@"
      ;;
    get)
      cmd_get "$@"
      ;;
    list)
      cmd_list "$@"
      ;;
    env)
      cmd_env "$@"
      ;;
    run)
      cmd_run "$@"
      ;;
    backend)
      cmd_backend "$@"
      ;;
    broker)
      cmd_broker "$@"
      ;;
    migrate)
      cmd_migrate "$@"
      ;;
    audit)
      cmd_audit "$@"
      ;;
    -h|--help|help)
      kxxx_usage
      ;;
    *)
      kxxx_die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
